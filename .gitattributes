# ==============================================================================
# Git Attributes - End-of-Line normalization to LF
# ==============================================================================
* text=auto eol=lf
*.py text eol=lf diff=python
*.sh text eol=lf
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
